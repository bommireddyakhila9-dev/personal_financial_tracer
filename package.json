{
  "name": "budget-buddy-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Convenience scripts for the nested Budget Buddy project.",
  "scripts": {
    "dev": "npm --prefix budget-buddy-main/frontend run dev",
    "dev:frontend": "npm --prefix budget-buddy-main/frontend run dev",
    "dev:backend": "npm --prefix budget-buddy-main/backend run dev",
    "start": "npm --prefix budget-buddy-main/backend start",
    "build": "npm --prefix budget-buddy-main/frontend run build",
    "lint": "npm --prefix budget-buddy-main/frontend run lint",
    "test": "npm --prefix budget-buddy-main/frontend test",
    "install:all": "npm --prefix budget-buddy-main/frontend install && npm --prefix budget-buddy-main/backend install"
  }
}
